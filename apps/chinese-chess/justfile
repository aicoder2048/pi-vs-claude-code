default:
    @just --list

install:
    bun install

start:
    bun run start

# Install, build and launch; closing the window returns to the shell
chinese-chess:
    bun install
    bun run start

check:
    bun run check

smoke:
    bun run test:smoke

# Backfill finished local records (optional data directory argument)
learn data_dir="":
    bun run learn {{quote(data_dir)}}

build:
    bun run build

# Build the ad-hoc signed Apple Silicon DMG into release/
dist:
    bun install
    bun run dist

# Smoke-test the packaged app produced by `just dist`
smoke-dist:
    CHINESE_CHESS_APP="$PWD/release/mac-arm64/楚河.app/Contents/MacOS/楚河" bun tests/smoke.ts
