{
  "name": "chinese-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "楚河 · Pi Agent Harness 驱动的中国象棋桌面",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "build": "bun scripts/build.ts",
    "learn": "bun scripts/learn.ts",
    "start": "bun run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/*.test.ts",
    "test:smoke": "bun run build && bun tests/smoke.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "pack": "bun run build && electron-builder --mac --dir",
    "dist": "bun run build && electron-builder --mac"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.19.0",
    "electron": "^45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "local.pivscc.chinese-chess",
    "productName": "楚河",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!**/*.map",
      "package.json"
    ],
    "asar": true,
    "artifactName": "chuhe-${version}-mac-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.board-games",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
