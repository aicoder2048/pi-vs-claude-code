# 拾伍 · 五子棋桌面应用（在此目录运行 just 即可）
# 默认：安装依赖并启动 Electron
[default]
default: start

# 安装依赖与 Electron 运行时
install:
    bun install

# 启动桌面应用
start: install
    bun run start

# 规则与三级 AI 自动化测试
test:
    bun run test

# 实际启动 Electron，检查棋盘、AI、悔棋、续局和音乐
smoke: install
    bun run test:smoke

# 运行全部测试
check: test smoke
