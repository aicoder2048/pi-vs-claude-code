{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "renderer/**/*.ts",
    "extensions/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".local", "artifacts"]
}
