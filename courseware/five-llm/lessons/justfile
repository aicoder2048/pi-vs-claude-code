# five-llm 课程：本地静态服务 + AI 助教（DeepSeek，按量计费）+ AI 讲师。需要 just >= 1.54（[continue] 让 Ctrl+C 干净退出）。

default:
    @just --list

# Serve the course + AI tutor, e.g.: just courses 9000
courses port="8772":
    uv run --no-project python tools/serve.py --port {{port}}

# 启动课程（含 AI 助教）；加 --lecture [L01] 同时让 AI 讲师开讲（不写课号从第一课开始）。如：just course --lecture --port 9000
[continue]
course *args:
    uv run --no-project python tools/course.py {{args}}

# AI 讲师开讲（课程服务已在另一个终端运行时用），如：just lecture L01 --from s3
[continue]
lecture lesson *args:
    cd lecturer && uv run lecturer.py run {{lesson}} {{args}}

# 预合成 AI 讲师音频；不写课号 = 全部。如：just lecture-audio L01
lecture-audio *lessons:
    cd lecturer && uv run lecturer.py audio {{lessons}}

# 讲稿自检（不用启动服务，不调用模型）；不写课号 = 全部。如：just lecture-check L01 --readouts
lecture-check *args:
    cd lecturer && uv run lecturer.py check {{args}}
